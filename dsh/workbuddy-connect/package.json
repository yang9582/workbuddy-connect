{
  "name": "workbuddy-connect",
  "version": "2.2.1",
  "private": true,
  "type": "module",
  "description": "WorkBuddy 桌面 App 的模型接入 DeepSeek Harness：把本机 workbuddy-connect 桥接注册成 OpenAI 兼容 provider，并在输入框下方显示剩余积分与模型倍率。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
